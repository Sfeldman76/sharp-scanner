{
  "version": "NFL_PRODUCTION_V1_GOVERNANCE_20261001",
  "principle": "retrain_often_promote_slowly",
  "production": {
    "markets": ["SPREADS", "H2H", "TOTALS"],
    "separate_frozen_backbones": true,
    "automatic_promotion": false,
    "production_model_mutation_during_scoring": false,
    "edge_engine_separate_from_probability_models": true
  },
  "cadence": {
    "live_scoring_and_market_shadow": {
      "cadence": "30_MINUTES_WHILE_GAMES_ARE_UPCOMING",
      "purpose": "capture pregame market states, systems and live model inputs",
      "retrain_models": false
    },
    "weekly_data_close": {
      "cadence": "AFTER_EACH_COMPLETED_NFL_WEEK",
      "actions": [
        "ingest_and_validate_final_results",
        "rebuild_leakage_safe_training_state_through_completed_week",
        "retrain_spread_h2h_totals_challenger_copies",
        "recalibrate_challenger_copies_using_time_forward_data_only",
        "score_challengers_against_frozen_production_champion",
        "append_results_to_model_registry"
      ],
      "production_promotion": false
    },
    "promotion_checkpoint": {
      "cadence": "EVERY_4_COMPLETED_WEEKS_OR_APPROX_60_PLUS_NEW_GAMES",
      "actions": [
        "compare_forward_log_loss_brier_calibration_and_market_specific_metrics",
        "check_stability_by_season_team_role_week_and_market_regime",
        "check_decision_coverage_and_edge_stability",
        "require_no_material_regression_on_critical_slices",
        "manual_or_governed_promotion_only_if_challenger_passes"
      ],
      "automatic_promotion": false
    },
    "light_challenger_research": {
      "cadence": "WEEKLY_AFTER_DATA_CLOSE",
      "scope": "fixed_known_feature_families_and_small_predeclared_variants",
      "production_authority": 0
    },
    "heavy_research": {
      "cadence": "EVERY_4_COMPLETED_WEEKS",
      "scope": [
        "new_feature_families",
        "new_model_challengers",
        "market_microstructure_analysis",
        "interaction_research",
        "system_mining"
      ],
      "rule": "newly_discovered_rules_or_models_start_as_frozen_shadow_challengers_and_do_not_receive_immediate_production_authority"
    },
    "offseason": {
      "cadence": "ONCE_AFTER_SEASON_FINALIZATION",
      "actions": [
        "full_history_rebuild",
        "feature_and_model_tournament",
        "calibration_rebuild",
        "system_family_review",
        "production_v_next_freeze",
        "new_season_forward_evaluation_plan"
      ]
    }
  },
  "data_cutoff_rules": {
    "a_game_can_train_only_after_final_settlement": true,
    "current_upcoming_week_outcomes_forbidden": true,
    "future_games_forbidden": true,
    "time_forward_validation_required": true,
    "prospective_shadow_evidence_not_backfilled": true
  },
  "system_miner": {
    "normal_discovery_cadence": "EVERY_4_COMPLETED_WEEKS",
    "rerun_weekly": false,
    "reason": "avoid repeated small-sample mining and definition drift",
    "new_family_policy": "freeze_definition_then_start_new_prospective_clock",
    "existing_family_policy": "do_not_retune_from_prospective_results"
  }
}
